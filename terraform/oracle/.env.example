# ============================================
# EMS Platform - Production Environment
# ============================================

# Image Registry (GHCR)
REGISTRY=ghcr.io/smarteventmanagementsystem
IMAGE_PREFIX=smarteventmanagementsystem
TAG=latest

# Nginx Proxy Manager
NPM_DB_PASSWORD=change-me
NPM_ROOT_PASSWORD=change-me

# PostgreSQL (External - GCP Cloud SQL)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=ems_events
DB_HOST=your-gcp-cloud-sql-ip

# Redis (External - GCP Memorystore)
REDIS_PASSWORD=your_redis_password
REDIS_HOST=your-gcp-redis-ip

# Kafka (Internal on VM)
KAFKA_BROKERS=kafka:29092

# JWT
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# OpenAI
OPENAI_API_KEY=

# CORS
ALLOWED_ORIGINS=*
