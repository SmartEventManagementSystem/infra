# ============================================
# EMS Platform - Production Environment
# ============================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ems_events
POSTGRES_USER=emsuser
POSTGRES_PASSWORD=change-this-password

# Airflow
AIRFLOW_FERNET_KEY=generate-with-openssl-rand-base64-32
AIRFLOW_SECRET_KEY=change-this-secret

# Superset
SUPERSET_SECRET_KEY=change-this-secret-key

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass123

# MinIO
MINIO_PASSWORD=minioadmin123

# Kafka
KAFKA_BROKERS=kafka:29092

# Elasticsearch
ELASTIC_PASSWORD=elastic123

# Domain
DOMAIN=ems.yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
