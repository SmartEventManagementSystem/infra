# ============================================
# EMS Platform - Production Environment
# ============================================

# Image Registry
REGISTRY=ghcr.io/smarteventmanagementsystem
IMAGE_PREFIX=smarteventmanagementsystem
TAG=latest

# Nginx Proxy Manager
NPM_DB_PASSWORD=change-me
NPM_ROOT_PASSWORD=change-me

# PostgreSQL
DB_USER=emsuser
DB_PASSWORD=change-me
DB_NAME=ems_events
DB_HOST=localhost

# Redis
REDIS_PASSWORD=change-me
REDIS_HOST=localhost

# Kafka
KAFKA_BROKERS=kafka:29092

# JWT
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# OpenAI
OPENAI_API_KEY=

# CORS
ALLOWED_ORIGINS=*
