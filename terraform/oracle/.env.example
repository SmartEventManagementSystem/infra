# ============================================
# EMS Platform - Production Environment
# ============================================

# Domain
DOMAIN=ems.yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Database (GCP Cloud SQL)
DB_HOST=35.xxx.xxx.xxx
DB_PORT=5432
DB_NAME=ems_events
DB_USER=emsuser
DB_PASSWORD=your-secure-db-password

# Airflow Database
AIRFLOW_DB_PASSWORD=airflow123

# Redis (GCP Memorystore)
REDIS_HOST=10.xxx.xxx.xxx
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# S3/MinIO
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_ENDPOINT=http://minio:9000
S3_BUCKET=warehouse

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
FERNET_KEY=your-fernet-key-generate-with-openssl-rand-base64-32

# Kafka (External or internal)
KAFKA_BROKERS=kafka:9092
KAFKA_CLUSTER_ID=random-uuid-here

# Python
PYTHONUNBUFFERED=1
